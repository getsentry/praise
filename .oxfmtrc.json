{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "printWidth": 120,
  "proseWrap": "always",
  "singleQuote": true,
  "sortPackageJson": false,
  "trailingComma": "all",
  "ignorePatterns": ["dist/**", "node_modules/**", "package-lock.json"],
  "overrides": [{ "files": ["*.md", "*.mdc"], "options": { "proseWrap": "preserve" } }]
}
