{
  "name": "chrome-extension-typescript-starter",
  "version": "0.0.1",
  "description": "chrome-extension-typescript-starter",
  "main": "index.js",
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "build": "tsc --noEmit && webpack --config webpack/webpack.prod.js",
    "clean": "rimraf dist",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "style": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chibat/chrome-extension-typescript-starter.git"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-textarea-autosize": "^8.5.9"
  },
  "devDependencies": {
    "@swc/core": "^1.16.0",
    "@swc/jest": "^0.2.39",
    "@types/chrome": "^0.2.6",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "copy-webpack-plugin": "^14.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "swc-loader": "^0.2.7",
    "typescript": "^7.0.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-merge": "^6.0.1"
  },
  "allowScripts": {
    "@swc/core@1.16.0": true
  }
}
